# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=8080

# Required. No wildcard fallback — server refuses to start if unset.
# Comma-separated allowlist. Example: https://app.example.com,http://localhost:5173
CORS_ORIGIN=

# Atlas example:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lastmile?retryWrites=true&w=majority
# MongoDB transactions require a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/lastmile

# Long random string, >= 32 chars. Process refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Email (Resend). Required unless EMAIL_STUB=true.
# Generate at https://resend.com/api-keys. Sender domain must be verified.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM="Last-Mile Tracker <no-reply@your-domain.com>"
# FRONTEND_URL=https://your-frontend-domain.com
# Set to "true" to skip real sending and just log to console (dev only).
# EMAIL_STUB=false

# Used in Step 10 (seed). Uncomment then.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME="Seed Admin"

# Razorpay (test mode, prepaid). Get test keys from the Razorpay dashboard.
# Server starts without them (COD still works); payment endpoints return 422.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# RAG — OpenRouter (qwen/qwen3-embedding-8b for vectors + chat via OpenRouter)
# Get key at https://openrouter.ai/keys — required for rag:ingest and /api/ai/*.
# Server still starts without it, but RAG falls back to extractive answers.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
# OPENROUTER_CHAT_MODEL=qwen/qwen3-32b
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=DispatchPro