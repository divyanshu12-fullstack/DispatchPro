{
  "name": "last-mile-delivery-backend",
  "version": "0.1.0",
  "description": "Last-Mile Delivery Tracker — backend (MERN).",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "rag:ingest": "node rag/scripts/ingestFaqMd.js",
    "rag:ingest:dry": "node rag/scripts/ingestFaqMd.js --dry",
    "rag:ingest:noembed": "node rag/scripts/ingestFaqMd.js --no-embed",
    "rag:index:create": "node rag/scripts/createVectorIndex.js",
    "rag:index:check": "node -e \"import('dotenv/config').then(async()=>{const m=await import('mongoose'); await m.default.connect(process.env.MONGO_URI); const c=m.default.connection.db.collection('kbchunks'); const cur=await c.listSearchIndexes(); console.log(JSON.stringify(await cur.toArray(),null,2)); await m.default.disconnect();})\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "razorpay": "^2.9.8",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "bcrypt": true
  }
}
